generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

enum Role {
  customer
  fundi
  admin
}

enum BookingStatus {
  // Set when a customer sends a tender to a technician; unchanged until
  // the technician responds.
  pending
  // Set when the technician accepts the tender.
  active
  // Set when the technician declines the tender.
  rejected
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  fullName      String    @map("full_name")
  email         String    @unique
  phone         String?   @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(customer)
  emailVerified Boolean   @default(false) @map("email_verified")
  // Relative URL under /uploads (e.g. "/uploads/avatars/<uuid>.jpg"),
  // served statically - see src/app.ts. Set via POST /api/users/me/avatar.
  avatarUrl     String?   @map("avatar_url")
  // Touched on every authenticated request (see requireAuth in
  // auth.middleware.ts) so the mobile app's "online" dot reflects real
  // activity instead of a client-only guess.
  lastActiveAt  DateTime? @map("last_active_at")

  // Live location, published only by technician (fundi) accounts via
  // PATCH /api/users/me/location (see user.controller.ts) - customers'
  // own position is read straight from on-device GPS and never sent to
  // or stored on the server. Both null until a technician's app sends
  // its first ping. A technician only ever appears on a customer's map
  // while locationUpdatedAt is recent (see LOCATION_FRESHNESS_MINUTES in
  // utils/geo.ts) - that recency check IS what "online / ready for
  // bookings" means for this feature, so there's no separate flag for it.
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime? @map("location_updated_at")

  // Minimal technician-profile fields needed to power the customer map's
  // technician cards (see mobile: services/technicians.ts, TechnicianCard.tsx).
  // Deliberately plain columns on User rather than a separate
  // TechnicianProfile model for now, since there's no profile-editing
  // flow yet either - worth revisiting once technician onboarding grows
  // into something bigger than "a few fields". specialty/skills/rating
  // are meaningless for customer/admin accounts and simply stay at their
  // defaults for those roles.
  specialty   String?
  skills      String[] @default([])
  rating      Float?   @default(0)
  ratingCount Int      @default(0) @map("rating_count")

  // Qualification/onboarding fields (technician accounts only) - see
  // utils/qualification.ts for the scoring rubric. qualificationScore is
  // recomputed and stored every time any of these fields change (see
  // updateTechnicianProfile/uploadIdDocument in user.controller.ts), so it
  // can be filtered on directly (technician.controller.ts) instead of
  // recomputing it on every nearby-technicians request.
  bio                String?
  hourlyRate         Float?
  yearsExperience    Int?     @map("years_experience")
  // Relative /uploads path, same pattern as avatarUrl.
  idDocumentUrl      String?  @map("id_document_url")
  qualificationScore Int      @default(0) @map("qualification_score")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  bookingsAsCustomer        Booking[]      @relation("BookingCustomer")
  bookingsAsTechnician      Booking[]      @relation("BookingTechnician")
  conversationsAsCustomer   Conversation[] @relation("ConversationCustomer")
  conversationsAsTechnician Conversation[] @relation("ConversationTechnician")
  messages                  Message[]

  @@map("users")
}

model Booking {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String        @map("customer_id") @db.Uuid
  customer     User          @relation("BookingCustomer", fields: [customerId], references: [id])
  technicianId String        @map("technician_id") @db.Uuid
  technician   User          @relation("BookingTechnician", fields: [technicianId], references: [id])
  service      String
  status       BookingStatus @default(pending)
  scheduledFor DateTime      @map("scheduled_for")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([technicianId])
  @@map("bookings")
}

model Conversation {
  id           String    @id @default(uuid()) @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  customer     User      @relation("ConversationCustomer", fields: [customerId], references: [id])
  // Null for the customer's built-in support conversation (isSupport = true).
  technicianId String?   @map("technician_id") @db.Uuid
  technician   User?     @relation("ConversationTechnician", fields: [technicianId], references: [id])
  isSupport    Boolean   @default(false) @map("is_support")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  messages Message[]

  @@index([customerId])
  @@index([technicianId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  // Null for system-authored messages (e.g. the support conversation's
  // opening greeting) rather than a real user.
  senderId       String?      @map("sender_id") @db.Uuid
  sender         User?        @relation(fields: [senderId], references: [id])
  text           String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}
