generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

enum Role {
  customer
  fundi
  admin
}

enum BookingStatus {
  // Set when a customer sends a tender to a technician; unchanged until
  // the technician responds.
  pending
  // Set when the technician accepts the tender.
  active
  // Set when the technician declines the tender.
  rejected
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  fullName      String    @map("full_name")
  email         String    @unique
  phone         String?   @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(customer)
  emailVerified Boolean   @default(false) @map("email_verified")
  // Relative URL under /uploads (e.g. "/uploads/avatars/<uuid>.jpg"),
  // served statically - see src/app.ts. Set via POST /api/users/me/avatar.
  avatarUrl     String?   @map("avatar_url")
  // Touched on every authenticated request (see requireAuth in
  // auth.middleware.ts) so the mobile app's "online" dot reflects real
  // activity instead of a client-only guess.
  lastActiveAt  DateTime? @map("last_active_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  bookingsAsCustomer        Booking[]      @relation("BookingCustomer")
  bookingsAsTechnician      Booking[]      @relation("BookingTechnician")
  conversationsAsCustomer   Conversation[] @relation("ConversationCustomer")
  conversationsAsTechnician Conversation[] @relation("ConversationTechnician")
  messages                  Message[]

  @@map("users")
}

model Booking {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String        @map("customer_id") @db.Uuid
  customer     User          @relation("BookingCustomer", fields: [customerId], references: [id])
  technicianId String        @map("technician_id") @db.Uuid
  technician   User          @relation("BookingTechnician", fields: [technicianId], references: [id])
  service      String
  status       BookingStatus @default(pending)
  scheduledFor DateTime      @map("scheduled_for")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([technicianId])
  @@map("bookings")
}

model Conversation {
  id           String    @id @default(uuid()) @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  customer     User      @relation("ConversationCustomer", fields: [customerId], references: [id])
  // Null for the customer's built-in support conversation (isSupport = true).
  technicianId String?   @map("technician_id") @db.Uuid
  technician   User?     @relation("ConversationTechnician", fields: [technicianId], references: [id])
  isSupport    Boolean   @default(false) @map("is_support")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  messages Message[]

  @@index([customerId])
  @@index([technicianId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  // Null for system-authored messages (e.g. the support conversation's
  // opening greeting) rather than a real user.
  senderId       String?      @map("sender_id") @db.Uuid
  sender         User?        @relation(fields: [senderId], references: [id])
  text           String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}
