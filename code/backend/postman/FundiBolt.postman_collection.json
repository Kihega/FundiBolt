{
  "info": {
    "_postman_id": "cce1beb2-7970-40cc-ae6f-e44df0f6fb11",
    "name": "FundiBolt API",
    "description": "Manual/CI-runnable checks for the FundiBolt auth + OTP flow. Run with the Postman app, or via newman: `npx newman run postman/FundiBolt.postman_collection.json --env-var baseUrl=http://localhost:4000`. These hit a real running backend (and real DB/Redis), so they're a smoke/integration layer on top of the Jest unit+integration tests, not a replacement for them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "testEmail", "value": "postman-test@example.com" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('responds with a status field', function () {",
              "    pm.expect(pm.response.json()).to.have.property('status');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Signup - missing fields rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/signup",
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "OTP send - missing email rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/otp/send",
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "OTP verify - old dev-bypass code must be rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/otp/verify",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{testEmail}}\", \"code\": \"123456\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 400 - the removed dev-bypass code must not work', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "OTP verify - garbage code rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/otp/verify",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{testEmail}}\", \"code\": \"000000\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
