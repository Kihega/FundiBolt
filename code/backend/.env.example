# Server
PORT=4000
NODE_ENV=development

# Database (Supabase Postgres) - use the TRANSACTION POOLER for normal app queries
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@<pooler-host>:6543/postgres
# Use the DIRECT connection only for migrations / one-off admin tasks
DATABASE_URL_DIRECT=postgresql://postgres:<PASSWORD>@<db-host>:5432/postgres

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Auth
JWT_SECRET=change-me-in-production

RESEND_API_KEY=
EMAIL_FROM=FundiBolt <onboarding@resend.dev>

# The API's own publicly-reachable base URL - used to turn stored relative
# upload paths (e.g. profile photos) into full URLs the mobile app can
# load. Defaults to http://localhost:<PORT> if unset; set this to your
# real dev tunnel (ngrok, etc.) or production domain so avatars actually
# render when the API isn't being accessed via localhost.
PUBLIC_API_URL=http://localhost:4000
