EXPO_PUBLIC_API_URL=http://localhost:4000

# Required for real Google Maps tiles to render on Android (see the long
# comment at the top of app.config.js for why this alone isn't enough -
# you also need a development build, not plain Expo Go).
#
# How to get one:
#   1. https://console.cloud.google.com/google/maps-apis/credentials
#   2. Create an API key.
#   3. Enable "Maps SDK for Android" for it (APIs & Services > Library).
#   4. Restrict it to Android apps + this project's package name/SHA-1
#      fingerprint once you have a real build, to stop anyone else from
#      using your key if it ever leaks.
GOOGLE_MAPS_ANDROID_API_KEY=


# CARTO basemap tiles (used by the Leaflet map - see
# components/MapSection.tsx). Free tier: 5,000,000 tile requests/month.
# Get one at https://carto.com/basemaps (no approval queue, key arrives by
# email). Must be prefixed EXPO_PUBLIC_ so it's readable from client-side
# code - without it, the map still works but shows CARTO's
# "API key required" watermark on the tiles.
EXPO_PUBLIC_CARTO_API_KEY=
